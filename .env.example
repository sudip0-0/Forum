# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://forum:forum@localhost:5433/forum_dev

# Auth
AUTH_SECRET=replace-with-local-secret
AUTH_URL=http://localhost:3000

# Email
APP_URL=http://localhost:3000
EMAIL_PROVIDER=smtp
EMAIL_FROM="Forum <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional OAuth later
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Rate limiting
REDIS_URL=redis://localhost:6379
# Use redis for public/staging/prod. Use memory only for local tests/dev when Redis is intentionally unavailable.
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_IN_MEMORY_FALLBACK=false

# Meilisearch later
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local-master-key

# Storage later
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=
