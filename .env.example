# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database
# Local compose maps Postgres to host 5434 and Redis to 6380.
DATABASE_URL=postgresql://forum:forum@localhost:5434/forum_dev
# Example production (PgBouncer):
# DATABASE_URL=postgresql://forum:SECRET@pgbouncer:6432/forum?pgbouncer=true&connection_limit=5

# Auth
AUTH_SECRET=replace-with-local-secret
AUTH_URL=http://localhost:3000

# Email
APP_URL=http://localhost:3000
EMAIL_PROVIDER=smtp
EMAIL_FROM="Forum <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# OAuth (optional — buttons appear when both ID and SECRET are set)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Rate limiting
REDIS_URL=redis://localhost:6380
RATE_LIMIT_BACKEND=redis
RATE_LIMIT_IN_MEMORY_FALLBACK=false

# Meilisearch (optional — docker compose --profile search up -d)
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_API_KEY=local-master-key

# Storage
STORAGE_DRIVER=local
# S3-compatible (optional):
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=

# Ops
SENTRY_DSN=
CRON_SECRET=
FEATURE_AI=
AI_API_URL=
AI_API_KEY=
